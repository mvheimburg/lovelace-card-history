{
  "name": "lovelace-card-history",
  "version": "0.1.0",
  "description": "Shared history view for our Lovelace cards: recorder loading, line chart, state timeline and dialog, in English and Bokm\u00e5l",
  "type": "module",
  "license": "MIT",
  "repository": "github:mvheimburg/lovelace-card-history",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "src"
  ],
  "sideEffects": false,
  "scripts": {
    "test": "vitest run",
    "lint": "eslint src tests",
    "typecheck": "tsc --noEmit",
    "build": "rm -rf dist && tsc -p tsconfig.build.json && rollup -c"
  },
  "peerDependencies": {
    "lit": "^3.1.0"
  },
  "devDependencies": {
    "@vitest/browser-playwright": "^5.0.1",
    "eslint": "^9.0.0",
    "lit": "^3.1.0",
    "playwright": "^1.49.1",
    "prettier": "^3.3.0",
    "typescript": "^5.5.0",
    "typescript-eslint": "^8.57.0",
    "vite": "^7.1.0",
    "vitest": "^5.0.1",
    "@rollup/plugin-node-resolve": "^15.2.3",
    "@rollup/plugin-typescript": "^11.1.6",
    "rollup": "^4.21.0",
    "tslib": "^2.8.1"
  }
}
